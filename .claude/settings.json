{
  "permissions": {
    "allow": [
      "Skill(superpowers:brainstorming)", "Skill(superpowers:writing-plans)",
      "Skill(superpowers:executing-plans)", "Skill(superpowers:test-driven-development)",
      "Bash(git status *)", "Bash(git diff *)", "Bash(git add *)", "Bash(git commit *)",
      "Bash(npm test)", "Bash(npm test *)",
      "Edit(/docs/superpowers/**)", "Edit(/src/**)", "Edit(/test/**)",
      "Workflow(superpowers-spec-plan)", "Workflow(superpowers-implement)"
    ],
    "ask": [
      "Bash(git push *)", "Bash(npm install *)", "Edit(/CLAUDE.md)"
    ],
    "deny": [
      "Edit(/docs/superpowers/plans/*.APPROVED)", "Bash(*APPROVED*)",
      "Bash(git worktree *)",
      "Read(./.env)", "Read(./.env.*)",
      "Bash(curl *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sp-code-gate.sh", "timeout": 10 }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sp-artifact-check.sh", "timeout": 10 }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sp-phase-gate.sh", "timeout": 120 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sp-phase-gate.sh", "timeout": 120 }] }
    ]
  }
}
